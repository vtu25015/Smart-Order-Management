<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="test-insufficient-stock.xml"/>

    <munit:test
        name="test-insufficient-stock-suite"
        description="Test insufficient stock">

        <munit:behavior>

            <!-- Input: request quantity is 20 -->
            <munit:set-event doc:name="Set Event">
				<munit:payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    customer: {&#10;        name: "Tehazeeb",&#10;        email: "tehazeeb@example.com"&#10;    },&#10;    productId: "P101",&#10;    quantity: 20&#10;}]' encoding="Shift_JIS" mediaType="application/json" />

            </munit:set-event>


            <!-- Mock Product API -->
            <munit-tools:mock-when
                doc:name="Mock Product API"
                processor="http:request">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        whereValue="GET"
                        attributeName="method"/>

                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        value='#[%dw 2.0
output application/json
---
{
    productId: "P101",
    name: "Laptop",
    price: 50000,
    availableStock: 10
}]'
                        mediaType="application/json"
                        encoding="UTF-8"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>


        <munit:execution>

            <flow-ref
                doc:name="Flow-ref to post:\orders\:application\json\:smartorder-config"
                name="post:\orders:application\json:smartorder-config" doc:id="6b523c1b-cfe1-4163-b4ff-6795f74d3a5c"/>

        </munit:execution>


        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert that"
                expression="#[payload.errorCode]"
                is='#[MunitTools::equalTo("INSUFFICIENT_STOCK")]'/>

        </munit:validation>

    </munit:test>

</mule>